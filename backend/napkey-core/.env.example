# napkey-core configuration. Every value comes from the environment; nothing is
# read from a file on disk. In Coolify these go in the app's environment, not here.

# ---- Server ----
HOST=0.0.0.0
PORT=8081
LOG_LEVEL=info

# ---- Postgres ----
# Point at the internal Docker network name. Do not publish this port to the
# internet.
DATABASE_URL=postgres://napkey:CHANGE_ME@postgres:5432/napkey?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5

# ---- Sessions ----
# Minimum 32 bytes. Generate with: openssl rand -base64 48
# Rotating this logs everybody out.
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
SESSION_TTL=336h
# Leave true in production. false is only for local http development.
SECURE_COOKIES=true

# ---- Console ----
# Origin of the Next.js console. Used for CORS and for links in email.
PUBLIC_BASE_URL=https://napkey.vn

# ---- kiro-go data plane ----
# Internal address of kiro-go's admin API. Keys are pushed here; a key that never
# arrives cannot authenticate.
KIRO_ADMIN_URL=http://kiro-go:8080
KIRO_ADMIN_PASSWORD=CHANGE_ME_same_as_kiro_go_admin_password
KIRO_SYNC_INTERVAL=60s

# ---- Email ----
# "log" writes verification links to the log instead of sending them. Use it
# locally; in production this must be "smtp" or nobody can complete signup.
MAIL_PROVIDER=log
MAIL_FROM=NapKey <no-reply@napkey.vn>
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
EMAIL_TOKEN_TTL=24h

# ---- Usage reporting (Stage 3) ----
# These two go in kiro-go's environment, not here, and are listed for reference:
# kiro-go forwards per-request usage to this service's /internal/usage endpoint.
# Without them kiro-go still serves traffic but reports nothing, so the console
# shows no usage and nothing can be billed.
#   NAPKEY_CORE_URL=http://napkey-core:8081
#   NAPKEY_INTERNAL_TOKEN=<same value as KIRO_ADMIN_PASSWORD above>

# ---- Quotas (Stage 2: granted by hand, no wallet yet) ----
# 0 means unlimited, matching kiro-go's semantics.
DEFAULT_TOKEN_LIMIT=0
DEFAULT_CREDIT_LIMIT=0
MAX_KEYS_PER_USER=10

# ---- Wallet top-ups (Stage 4) ----
# Casso Webhook V2 security key. Keep only in Coolify secrets.
CASSO_WEBHOOK_SECRET=CHANGE_ME_casso_webhook_v2_security_key
# Read-only key used by the 15-minute transaction reconciliation job.
CASSO_API_KEY=CHANGE_ME_casso_read_only_api_key
BANK_NAME=Your bank
BANK_BIN=970436
BANK_ACCOUNT_NUMBER=0000000000
BANK_ACCOUNT_NAME=NAPKEY
# Maximum reserved for one in-flight API request. Unused credit is released on settlement.
WALLET_HOLD_VND=1000000

# ---- Admin ----
# Comma-separated allowlist. Empty means no account can reach /v1/admin/*.
ADMIN_EMAILS=
