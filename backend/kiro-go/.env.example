# Enables usage reporting plus wallet reserve/settle for NapKey-provisioned keys.
NAPKEY_CORE_URL=http://napkey-core:8081
NAPKEY_INTERNAL_TOKEN=CHANGE_ME_same_as_KIRO_ADMIN_PASSWORD
ADMIN_HOST=ops.example.com

# ---- 9Router upstream (the upstream NapKey serves from) ----
# Defaults to on. Only an explicit false value ("false", "0", "no", "off") switches
# back to the local account pool; a typo keeps 9Router rather than falling back to a
# pool that may hold no accounts and would fail every request.
#
# kiro-go refuses to start when neither upstream can serve, so a missing endpoint or
# key surfaces in the deploy log instead of as a customer-facing outage.
#
# When enabled, /v1/chat/completions and /v1/messages are both served by 9Router.
# The Anthropic endpoint is translated to Chat Completions and its SSE stream is
# reshaped, so Claude Code and the Anthropic SDKs keep working. Two Anthropic
# features have no equivalent and are dropped: extended thinking, and server tools
# such as web_search. Cache control hints are dropped from requests, though cache
# reads are still billed correctly when the upstream reports them.
#
# /v1/responses still returns 501. Falling back to the pool would serve from the
# upstream you just switched away from while billing as if you had not.
#
# Usage from this path reports credits=0 because the OpenAI protocol carries no
# credit meter. napkey-core prices it from token counts against model_prices, so
# that table must have a row for every model on sale before enabling this.
NINEROUTER_ENABLED=true
# Must include /v1: the code appends /chat/completions and /models to it, so a base
# without /v1 makes every call 404.
#NINEROUTER_RUNTIME_BASE_URL=https://gateway-admin.example.com/v1
#NINEROUTER_API_KEY=CHANGE_ME_internal_endpoint_key_not_a_customer_key
# Cloudflare Access service token. Both halves or neither; one alone yields a 403
# that looks like an upstream outage.
#NINEROUTER_CF_ACCESS_CLIENT_ID=
#NINEROUTER_CF_ACCESS_CLIENT_SECRET=
#NINEROUTER_TIMEOUT_MS=180000
# Model namespace. 9Router addresses models by provider pool, so the public id
# "claude-sonnet-5" is sent upstream as "Viberouter/claude-sonnet-5". Sending the
# public id unnamespaced returns 404 {"error":{"code":"upstream_status"}}.
#
# Defaults to Viberouter/ when unset, the pool carrying the full Claude line. Verify
# against your own instance before changing it: a prefix naming a pool the upstream
# does not have fails every request, not just some.
#
#   curl.exe -H "Authorization: Bearer $NINEROUTER_API_KEY" <base-url>/models
#
# Set it explicitly empty to disable namespacing for a flat-namespace deployment. An
# id that already contains a "/" is passed through unchanged.
#NINEROUTER_MODEL_PREFIX=Viberouter/
# Per-model overrides for names that do not follow the prefix convention:
#   public-id=upstream-id,public-id=upstream-id
#NINEROUTER_MODEL_MAP=